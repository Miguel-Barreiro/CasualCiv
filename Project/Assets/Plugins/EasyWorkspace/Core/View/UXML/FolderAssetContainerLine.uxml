    <ui:VisualElement name="AssetContainerLine" style="margin-right: 12px; margin-left: 12px; height: 36px;">
        <EasyWorkspace.EWAssetContainer name="Asset" class="asset-default" style="width: 100%; height: 100%; justify-content: center;">
            <ui:Label text="Title" name="AssetTitle" class="title-default" style="position: absolute; left: 36px; top: 0; right: 0; bottom: 0; width: auto; height: auto; -unity-text-align: middle-left;" />
            <ui:VisualElement name="AssetIcon" class="asset-default" style="border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); width: 24px; height: 24px; left: 6px; position: absolute; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px;" />
        </EasyWorkspace.EWAssetContainer>
    </ui:VisualElement>
