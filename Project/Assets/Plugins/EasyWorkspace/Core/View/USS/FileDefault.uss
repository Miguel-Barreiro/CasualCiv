#ScrollView {
    opacity: 1;
    transition-delay: 0.15s;
    transition-duration: 0.1s;
    margin-top: 6px;
}

#IMGUIContainer {
    display: flex;
}

#Panel {
    width: 100%;
    height: 100%;
}

#ToolbarLineContainer {
    opacity: 1;
    transition-duration: 0.15s;
    margin-top: 6px;
    margin-right: 9px;
    margin-bottom: 3px;
    margin-left: 9px;
}

#CollapsedInfo {
    opacity: 0;
    transition-duration: 0.15s;
}

#ModeSwitch {
    transition-duration: 0.15s;
    display: flex;
    opacity: 1;
}
