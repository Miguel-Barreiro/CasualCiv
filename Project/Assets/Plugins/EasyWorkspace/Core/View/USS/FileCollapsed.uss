#ScrollView {
    opacity: 0;
    transition-duration: 0s;
    transition-delay: 0s;
}

#IMGUIContainer {
    transition-duration: 0s;
    transition-delay: 0s;
    display: none;
}

#Panel {
    height: 42px;
}

#ToolbarLineContainer {
    opacity: 0;
}

#CollapsedInfo {
    opacity: 1;
}

#ModeSwitch {
    display: none;
    opacity: 0;
}
